<?xml version="1.0" encoding="utf-8"?>
<!--suppress AndroidDomInspection -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res/com.discord"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResAuto, InvalidId"
    android:id="@+id/onboarding_header"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:layout_below="@id/app_bar_layout"
    style="@app:style/UiKit.ViewGroup.LinearLayout">
    <LinearLayout
        android:orientation="horizontal"
        style="@app:style/UiKit.ViewGroup.LinearLayout">
        <TextView
            android:textColor="@app:color/primary_dark_345"
            android:id="@+id/onboarding_prompt_index"
            android:textAlignment="viewStart"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:text="@string/question_index"
            style="@app:style/UiKit.TextView"/>
        <TextView
            android:textColor="?app:attr/colorInteractiveMuted"
            android:id="@+id/weird_dot"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:text="@string/weird_symbol"
            style="@app:style/UiKit.TextView"/>
        <TextView
            android:textColor="@app:color/uikit_btn_bg_color_selector_brand"
            android:id="@+id/onboarding_prompt_required"
            android:visibility="gone"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/required"
            style="@app:style/UiKit.TextView"/>
    </LinearLayout>
    <TextView
        android:textColor="?app:attr/colorHeaderPrimary"
        android:id="@+id/onboarding_prompt_text"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="?app:attr/font_primary_semibold"
        android:textSize="@app:dimen/uikit_textsize_xxlarge"
        style="@app:style/FriendsList.EmptyState.Subtitle"/>
</LinearLayout>
