<?xml version="1.0" encoding="utf-8"?>
<!--suppress AndroidDomInspection -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/com.discord"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="0dp"
    android:paddingStart="0dp"
    android:paddingEnd="@app:dimen/chat_cell_horizontal_spacing_padding"
    android:layout_marginEnd="@app:dimen/chat_cell_horizontal_spacing_margin"
    android:background="?app:attr/colorBackgroundPrimary"
    tools:ignore="ResAuto, InvalidId"
    style="@app:style/UiKit.ViewGroup.CoordinatorLayout">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/uikit_chat_guideline"
        style="@app:style/UiKit.Chat.Guideline"/>
    <ImageView
        android:id="@+id/item_icon"
        android:layout_width="@app:dimen/avatar_size_small"
        android:layout_height="@app:dimen/avatar_size_small"
        android:layout_marginTop="3dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="@app:dimen/chat_cell_horizontal_spacing_total"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@app:dimen/chat_cell_vertical_spacing_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/uikit_chat_guideline"
        app:layout_constraintTop_toTopOf="parent">
        <com.discord.utilities.view.text.LinkifiedTextView
            android:textColor="?app:attr/colorTextMuted"
            android:id="@+id/item_text"
            android:layout_width="match_parent"
            android:lineSpacingMultiplier="1"
            style="@app:style/UiKit.TextView.Large"/>
        <TextView
            android:visibility="gone"
            android:textSize="@app:dimen/uikit_textsize_small"
            android:textColor="?app:attr/colorTextMuted"
            android:gravity="center_vertical"
            android:id="@+id/item_timestamp"
            android:layout_marginBottom="1dp"
            android:maxWidth="150dp"
            android:text="@app:string/sample_time_pm"
            android:singleLine="true"
            style="@app:style/UiKit.TextView"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/chat_list_adapter_item_thread_embed_spine"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:src="@app:drawable/thread_embed_spine_drawable"
        android:layout_marginStart="@app:dimen/chat_list_spine_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>